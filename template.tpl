scenarios:
- name: Product page view sets br_data and loads the tracker
  code: |-
    const mockData = {
      pixelType: 'pageview',
      accountId: '6702',
      ptype: 'product',
      prodId: 'P1',
      prodName: 'Blue Dress',
      sku: 'S1',
      consentMode: 'off'
    };
    let brData;
    let scriptUrl;
    mock('setInWindow', function(key, value, overwrite) {
      if (key === 'br_data') { brData = value; }
      return true;
    });
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      scriptUrl = url;
      onSuccess();
    });
    runCode(mockData);
    assertThat(scriptUrl).isEqualTo('https://cdn.brcdn.com/v1/br-trk-6702.js');
    assertThat(brData).isEqualTo({acct_id: '6702', ptype: 'product', prod_id: 'P1', prod_name: 'Blue Dress', sku: 'S1'});
    assertApi('gtmOnSuccess').wasCalled();
