___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const log = require('logToConsole');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const getUrl = require('getUrl');
const getType = require('getType');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const Math = require('Math');
const makeTableMap = require('makeTableMap');
const Object = require('Object');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');

const pixelType = data.pixelType || 'pageview';
const accountId = data.accountId ? makeString(data.accountId) : '';

const debugLog = (msg) => {
  if (data.debug) {
    log('Bloomreach GTM - ' + msg);
  }
};

// Treat undefined, null and empty strings as "not set" so optional fields
// never reach Bloomreach as "undefined" (a documented data-quality issue).
const isSet = (v) => v !== undefined && v !== null && makeString(v) !== '';
const setIf = (obj, key, v) => {
  if (isSet(v)) {
    obj[key] = makeString(v);
  }
};
const firstSet = (a, b) => isSet(a) ? a : b;

// "products_en, content_en" -> [{name: 'products_en'}, {name: 'content_en'}]
const toCatalogs = (v) => {
  if (!isSet(v)) {
    return undefined;
  }
  if (getType(v) === 'array') {
    return v;
  }
  const out = [];
  makeString(v).split(',').forEach((name) => {
    const n = name.trim();
    if (n) {
      out.push({name: n});
    }
  });
  return out.length ? out : undefined;
};

// GA4 ecommerce items, read only when the tag needs them.
const ga4Items = () => {
  const items = copyFromDataLayer('ecommerce.items', 2);
  return getType(items) === 'array' ? items : [];
};

// Map one item (GA4 or Bloomreach shape) to Bloomreach's prod_id/sku/name.
// In GA4 item_id is either the product ID or the SKU; the idMapping setting
// says which, and item_group_id carries the product ID in the second case.
const mapItem = (item) => {
  const out = {};
  if (getType(item) !== 'object') {
    return out;
  }
  if (isSet(item.prod_id)) {
    out.prod_id = makeString(item.prod_id);
    out.sku = isSet(item.sku) ? makeString(item.sku) : '';
  } else if (data.idMapping === 'sku') {
    out.prod_id = makeString(firstSet(item.item_group_id, item.item_id));
    out.sku = isSet(item.item_id) ? makeString(item.item_id) : '';
  } else {
    out.prod_id = isSet(item.item_id) ? makeString(item.item_id) : '';
    out.sku = '';
  }
  const name = firstSet(item.name, item.item_name);
  if (isSet(name)) {
    out.name = makeString(name);
  }
  if (isSet(item.quantity)) {
    out.quantity = makeString(item.quantity);
  }
  if (isSet(item.price)) {
    out.price = makeString(item.price);
  }
  return out;
};

// br-trk escapes only the first ! and ' in a basket value, and a second one
// would split the item, so escape all of them before handing the basket over.
const escapeBasketValue = (v) => makeString(v).split("'").join('%27').split('!').join('%21');
const buildBasket = () => {
  const source = isSet(data.basketItems) ? data.basketItems : ga4Items();
  const items = [];
  if (getType(source) === 'array') {
    source.forEach((item) => {
      const mapped = mapItem(item);
      if (mapped.prod_id) {
        Object.keys(mapped).forEach((k) => {
          mapped[k] = escapeBasketValue(mapped[k]);
        });
        items.push(mapped);
      }
    });
  }
  return {items: items};
};

// br-trk throws (and drops the page view) when a basket has items but no
// basket_value, so fall back to the sum of price x quantity.
const basketTotal = (basket) => {
  let total = 0;
  basket.items.forEach((it) => {
    total += (makeNumber(it.price) || 0) * (isSet(it.quantity) ? (makeNumber(it.quantity) || 0) : 1);
  });
  return makeString(Math.round(total * 100) / 100);
};

// Global variables shared by page views and events.
const buildBase = () => {
  const d = {acct_id: accountId};
  setIf(d, 'domain_key', data.domainKey);
  setIf(d, 'view_id', data.viewId);
  setIf(d, 'user_id', data.userId);
  if (data.testData) {
    d.test_data = true;
  }
  if (data.debugMode) {
    d.debug = true;
  }
  if (data.extraParams && data.extraParams.length) {
    const extra = makeTableMap(data.extraParams, 'key', 'value') || {};
    Object.keys(extra).forEach((k) => setIf(d, k, extra[k]));
  }
  return d;
};

const buildPageData = () => {
  const d = buildBase();
  const ptype = makeString(data.ptype || 'other');
  d.ptype = ptype;
  setIf(d, 'title', data.title);

  if (ptype === 'product') {
    const item = mapItem(ga4Items()[0]);
    setIf(d, 'prod_id', firstSet(data.prodId, item.prod_id));
    setIf(d, 'prod_name', firstSet(data.prodName, item.name));
    setIf(d, 'sku', firstSet(data.sku, item.sku));
  } else if (ptype === 'category') {
    setIf(d, 'cat_id', data.catId);
    setIf(d, 'cat', data.cat);
  } else if (ptype === 'search') {
    setIf(d, 'search_term', data.searchTerm);
  } else if (ptype === 'content') {
    setIf(d, 'item_id', data.itemId);
    setIf(d, 'item_name', data.itemName);
  } else if (ptype === 'conversion') {
    d.is_conversion = 1;
    setIf(d, 'order_id', firstSet(data.orderId, copyFromDataLayer('ecommerce.transaction_id', 2)));
    setIf(d, 'basket_value', firstSet(data.basketValue, copyFromDataLayer('ecommerce.value', 2)));
    setIf(d, 'currency', firstSet(data.currency, copyFromDataLayer('ecommerce.currency', 2)));
    d.basket = buildBasket();
    if (!d.basket_value) {
      d.basket_value = basketTotal(d.basket);
    }
    if (!d.order_id || !d.basket.items.length) {
      debugLog('Warning: conversion without order ID or basket items. Fire this tag on the purchase event, after the dataLayer push.');
    }
  }

  const catalogs = toCatalogs(data.catalogs);
  if (catalogs && (ptype === 'search' || ptype === 'content')) {
    d.catalogs = catalogs;
  }
  return d;
};

// Event pixels: group + etype pairs from Bloomreach's pixel reference.
const EVENTS = {
  addToCart: {group: 'cart', etype: 'click-add', deferred: false},
  quickView: {group: 'product', etype: 'quickview', deferred: false},
  searchSubmit: {group: 'suggest', etype: 'submit', deferred: true},
  suggestClick: {group: 'suggest', etype: 'click', deferred: true}
};

const buildEventData = () => {
  const d = {};
  if (pixelType === 'addToCart' || pixelType === 'quickView') {
    const item = mapItem(ga4Items()[0]);
    setIf(d, 'prod_id', firstSet(data.evProdId, item.prod_id));
    d.sku = makeString(firstSet(data.evSku, item.sku || ''));
    if (pixelType === 'quickView') {
      setIf(d, 'prod_name', firstSet(data.evProdName, item.name));
    }
  } else {
    setIf(d, 'q', data.query);
    if (pixelType === 'suggestClick') {
      setIf(d, 'aq', data.typedQuery);
    }
    const catalogs = toCatalogs(data.catalogs);
    if (catalogs) {
      d.catalogs = catalogs;
    }
  }
  return d;
};

const getTracker = () => callInWindow('BrTrk.getTracker');
const trackerUrl = 'https://cdn.brcdn.com/v1/br-trk-' + accountId + '.js';

// Page view: set window.br_data, then load br-trk. The tracker reads br_data
// and fires the page view pixel itself once the page has loaded.
const loadWithPageView = (brData) => {
  setInWindow('br_data', brData, true);
  debugLog('br_data set, loading ' + trackerUrl);
  injectScript(trackerUrl, () => {
    debugLog('Tracker loaded');
    data.gtmOnSuccess();
  }, () => {
    debugLog('Error: tracker failed to load');
    data.gtmOnFailure();
  }, 'bloomreach-' + accountId);
};

let hasFired = false;
const fire = () => {
  if (hasFired) {
    return;
  }
  hasFired = true;

  if (pixelType === 'pageview') {
    loadWithPageView(buildPageData());
    return;
  }

  if (pixelType === 'virtualPageview') {
    const brData = buildPageData();
    brData.orig_ref_url = getUrl();
    const tracker = getTracker();
    if (!tracker) {
      // First route of the app: nothing loaded yet, so this is a normal page view.
      debugLog('Tracker not loaded yet, sending as initial page view');
      loadWithPageView(brData);
      return;
    }
    tracker.updateBrData(brData);
    tracker.logPageView();
    debugLog('Virtual page view sent: ' + brData.ptype);
    data.gtmOnSuccess();
    return;
  }

  const ev = EVENTS[pixelType];
  if (!ev) {
    debugLog('Error: unknown pixel type ' + pixelType);
    data.gtmOnFailure();
    return;
  }
  const tracker = getTracker();
  if (!tracker) {
    debugLog('Error: Bloomreach tracker not ready. It starts at window load (or right away if the page has finished parsing), so trigger event tags on Window Loaded or later interactions, after the Page view tag.');
    data.gtmOnFailure();
    return;
  }
  const eventData = buildEventData();
  // Search and suggest events are deferred by Bloomreach: stored and sent with
  // the next page view, because the click navigates away.
  tracker.logEvent(ev.group, ev.etype, eventData, {}, ev.deferred);
  debugLog('Event sent: ' + ev.group + '/' + ev.etype);
  data.gtmOnSuccess();
};

if (!accountId) {
  debugLog('Error: Account ID is required');
  data.gtmOnFailure();
  return;
}

// Consent gate. Bloomreach sets a persistent visitor cookie (_br_uid_2) for
// analytics and personalisation, so the default mode waits for
// analytics_storage. isConsentGranted returns true when Consent Mode is not
// configured, so sites without it keep firing.
const consentMode = data.consentMode || 'auto';
if (consentMode === 'off' || isConsentGranted('analytics_storage')) {
  fire();
} else {
  debugLog('Waiting for analytics_storage consent');
  addConsentListener('analytics_storage', (consentType, granted) => {
    if (granted) {
      fire();
    }
  });
}


